#include<stdio.h>
int main()
{
    int n,temp,digits=0,first,last,middle,pow=1,result;

    scanf("%d",&n);

    temp=n;
    last=n%10;

    while(temp>0)
    {
        digits++;
        temp=temp/10;
    }

    for(int i=1;i<digits;i++)
        pow=pow*10;

    first=n/pow;
    middle=(n%pow)/10;

    result=last*pow + middle*10 + first;

    printf("%d",result);

    return 0;
}
